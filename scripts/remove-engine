#!/usr/bin/env bash
# Remove the engine runtime, launcher, and user unit installed by install-engine.
# Leaves the sync folder, config, state, audit log, recycle bin, and keyring alone.
set -euo pipefail

PLUGIN_ID='io.github.zakkoo.proton-drive'
MARKER="installed-by=${PLUGIN_ID}"

DATA_HOME=${XDG_DATA_HOME:-${HOME:?}/.local/share}
RUNTIME="${DATA_HOME}/proton-drive-sync/runtime"
LAUNCHER="${HOME:?}/.local/bin/proton-drive-sync"
UNIT=${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/proton-drive-sync.service

if [[ -f $UNIT ]] && grep -q "$MARKER" "$UNIT"; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user disable --now proton-drive-sync.service || true
    systemctl --user daemon-reload || true
  fi
  rm -f "$UNIT"
fi

if [[ -f $LAUNCHER && ! -L $LAUNCHER ]] && grep -q "$MARKER" "$LAUNCHER" && grep -Fxq "# runtime=${RUNTIME}" "$LAUNCHER"; then
  rm -f "$LAUNCHER"
fi

if [[ -d $RUNTIME && ! -L $RUNTIME && -f $RUNTIME/.installed-by ]] && grep -qx "$PLUGIN_ID" "$RUNTIME/.installed-by"; then
  rm -rf "$RUNTIME"
fi
